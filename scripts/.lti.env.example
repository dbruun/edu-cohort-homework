# LTI launch config for the test scripts (scripts/lti-launch*.mjs).
# Copy this file to scripts/.lti.env (gitignored) and fill in real values.
#
# This setup is SELF-OWNED: we are our own LTI platform, independent of lti-ri.
# Generate the keypair with `node scripts/gen-platform-key.mjs` (writes
# .platform-key.pem + .platform-key.pub.pem and prints LTI_KID), then register
# the tool with the public key as PLATFORM_PUBLIC_KEY. See README.md.

# Live LTI tool base URL (the ltijs Container App).
TOOL_URL=https://<your-lti-tool-host>

# Our own platform identity used to sign the id_token.
LTI_ISS=https://homework-tutor-platform.local
LTI_CLIENT_ID=<a GUID you generate>
LTI_DEPLOYMENT_ID=1
LTI_KID=<printed by gen-platform-key.mjs>

# Private key that matches PLATFORM_PUBLIC_KEY registered on the tool.
PLATFORM_PRIVATE_KEY=../.platform-key.pem

# Optional: platform OIDC auth endpoint (never called; a placeholder we abort).
# Defaults to ${LTI_ISS}/auth.
# LTI_AUTH_ENDPOINT=https://homework-tutor-platform.local/auth
