{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "searchSku": {
      "value": "${SEARCH_SKU=basic}"
    },
    "portalAppName": {
      "value": "${PORTAL_APP_NAME_OVERRIDE=}"
    },
    "portalAuthClientId": {
      "value": "${PORTAL_AUTH_CLIENT_ID=}"
    },
    "portalAuthKeyVaultResourceGroup": {
      "value": "${PORTAL_AUTH_KEY_VAULT_RESOURCE_GROUP=}"
    },
    "portalAuthKeyVaultName": {
      "value": "${PORTAL_AUTH_KEY_VAULT_NAME=}"
    },
    "portalAuthClientSecretName": {
      "value": "${PORTAL_AUTH_CLIENT_SECRET_NAME=}"
    },
    "portalAuthClientSecret": {
      "value": "${PORTAL_AUTH_CLIENT_SECRET=}"
    },
    "portalAuthTenantId": {
      "value": "${AZURE_TENANT_ID}"
    }
  }
}
