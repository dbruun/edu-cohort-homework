# Local dev config for the AG-UI bridge. Copy to bridge/.env and edit.
# Foundry project endpoint from the lab deploy (Step 1 output).
FOUNDRY_PROJECT_ENDPOINT=https://aif-<env>.services.ai.azure.com/api/projects/homework
# Name of the agent you created in the Foundry portal (Step 3).
FOUNDRY_AGENT_NAME=homework-tutor
# Prompt/declarative agents (portal-created) use the non-preview route.
FOUNDRY_ALLOW_PREVIEW=false
# CORS: * lets the local file:// chat page call the bridge.
ALLOWED_ORIGINS=*
