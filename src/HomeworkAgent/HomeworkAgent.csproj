<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <!-- NU1903: suppress package vulnerability audit warnings for preview/alpha packages from the azure-sdk-for-net feed.
         NU1605: suppress downgrade warnings that arise from preview transitive dependency resolution. -->
    <NoWarn>$(NoWarn);NU1903;NU1605</NoWarn>
    <UserSecretsId>56bfed6a-df91-4ee6-987f-ed378c5c26b5</UserSecretsId>
  </PropertyGroup>

  <PropertyGroup>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Agent Framework hosting — provides AgentHost, AddFoundryResponses, MapFoundryResponses -->
    <PackageReference Include="Microsoft.Agents.AI.Foundry.Hosting" Version="1.12.0-preview.260629.1" />
    <!-- Foundry SDK — provides AIProjectClient, AsAIAgent, and DefaultAzureCredential -->
    <PackageReference Include="Azure.AI.Projects" Version="2.1.0-beta.3" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="instructions/**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Pedagogy/**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
