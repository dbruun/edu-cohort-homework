<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <UserSecretsId>56bfed6a-df91-4ee6-987f-ed378c5c26b5</UserSecretsId>
  </PropertyGroup>

  <PropertyGroup>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <!-- NU1903: preview package vulnerability audit; NU1605: preview transitive downgrade. -->
    <NoWarn>$(NoWarn);NU1903;NU1605</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="instructions/**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Pedagogy/**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Agent Framework AG-UI hosting: AddAGUIServer + MapAGUIServer -->
    <PackageReference Include="Microsoft.Agents.AI.Hosting.AGUI.AspNetCore" Version="1.15.0-preview.260722.1" />
    <!-- Foundry hosting: AIProjectClient.AsAIAgent -->
    <PackageReference Include="Microsoft.Agents.AI.Foundry.Hosting" Version="1.15.0-preview.260722.1" />
    <!-- Foundry SDK: AIProjectClient -->
    <PackageReference Include="Azure.AI.Projects" Version="2.1.0-beta.4" />
  </ItemGroup>
</Project>
