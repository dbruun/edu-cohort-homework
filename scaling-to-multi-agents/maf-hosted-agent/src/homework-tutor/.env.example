# Local dev config for the Python hosted tutor agent.
# Copy to .env and fill in. FOUNDRY_PROJECT_ENDPOINT is auto-injected when hosted.
FOUNDRY_PROJECT_ENDPOINT=https://aif-<env>.services.ai.azure.com/api/projects/homework
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini
AZURE_SEARCH_ENDPOINT=https://srch-<env>.search.windows.net
AZURE_SEARCH_INDEX_NAME=course-materials
